# Copy this file to .env and fill in real values.
# EXPO_PUBLIC_* variables are bundled into the client app - never put secret keys here.

# Firebase (Project settings -> General -> Your apps -> SDK setup and configuration)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Stripe publishable key (starts with pk_...) - safe to expose in the client
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Currency used for orders (ISO 4217 lowercase, e.g. inr, usd)
EXPO_PUBLIC_CURRENCY=inr
