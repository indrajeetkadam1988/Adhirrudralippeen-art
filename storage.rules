rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Reference images for custom art requests: only the uploading user
    // (or a signed-in admin, checked in Firestore) can write; anyone with
    // the download URL can read, which is required for the admin app to
    // display the images and for <Image> to render them.
    match /custom-requests/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
